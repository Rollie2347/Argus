# ============================================================
# Argus v0.3 — Environment Variables
# ============================================================

# REQUIRED — Google AI Studio API key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# REQUIRED — Google Cloud project ID (for Firestore memory)
GCP_PROJECT_ID=your_gcp_project_id

# REQUIRED — shared secret gating the WebSocket endpoint. Every client
# (frontend/index.html gets it injected server-side; mobile needs it in
# mobile/.env as EXPO_PUBLIC_WS_SHARED_SECRET) must send this exact value
# as part of its first message, or the connection is closed before any
# Gemini session is opened. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WS_SHARED_SECRET=

# Server port (Cloud Run sets this automatically)
PORT=8080

# ============================================================
# OPTIONAL — Customize location for weather + restaurant lookup
# Defaults to Chicago if not set
# ============================================================
WEATHER_LAT=41.88
WEATHER_LON=-87.63

# Your timezone (for time-aware responses)
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/Chicago

# ============================================================
# LOCAL DEVELOPMENT ONLY
# ============================================================
# Path to your GCP service account key JSON (for local Firestore access)
# On Cloud Run, default credentials are used automatically (no file needed)
# To create: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON key and save as backend/service-account.json
# (service-account.json is gitignored — never commit it)

# ============================================================
# OPTIONAL — Marketing redirect counter (GET /g/:slug)
# ============================================================
# Per-post click attribution for marketing/. None of these are secrets
# and none are required — the route works without them, it just redirects to
# the plain App Store URL.

# Override the redirect destination (defaults to Argus's App Store page).
# APPSTORE_URL=https://apps.apple.com/app/apple-store/id6761696821

# Apple's `pt` provider token. You CANNOT invent this — App Store Connect
# generates it the first time you create a campaign link, and the Campaigns tab
# only appears once the app has analytics data. Without it the `?c=` campaign
# token on a redirect is dropped, because a ct with no pt attributes nothing.
# APPSTORE_PROVIDER_TOKEN=

# Budgets for click LOG LINES, not for redirects. Exceeding either drops the
# log line and still redirects the visitor — measurement degrades, the user's
# path to the App Store never does.
# REDIRECT_LOG_PER_IP_PER_MIN=60
# REDIRECT_LOG_GLOBAL_PER_MIN=600
