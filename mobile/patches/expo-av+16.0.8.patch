+// Argus render meter (#64). Every AVPlayerItem gets a pass-through
+// MTAudioProcessingTap that measures the samples the player actually hands to
+// the output, process-wide. Silent turns load, run their playhead and finish
+// without a single error, so the one question left is whether the players
+// produce samples at all: rendered-and-audible frames on a silent turn put the
+// loss below the players (mixer / voice processing), zero puts it in them.
+// Globals, not per-tap storage, so nothing can be read after a tap is freed.
+static _Atomic uint64_t sArgusRenderFrames, sArgusAudibleFrames;
+static _Atomic uint32_t sArgusRenderPeak; // peak |sample| x 10000, reset on read
+static _Atomic uint32_t sArgusTapsInstalled, sArgusTapsFailed;
+static _Atomic int32_t sArgusTapIsFloat = -1, sArgusTapSampleRate;
+
+NSDictionary *ArgusRenderCounts(void)
+{
+  return @{
+    @"rf": @(atomic_load(&sArgusRenderFrames)),
+    @"rl": @(atomic_load(&sArgusAudibleFrames)),
+    @"pk": @(atomic_exchange(&sArgusRenderPeak, 0)),
+    @"ti": @(atomic_load(&sArgusTapsInstalled)),
+    @"tf": @(atomic_load(&sArgusTapsFailed)),
+    @"fl": @(atomic_load(&sArgusTapIsFloat)),
+    @"tsr": @(atomic_load(&sArgusTapSampleRate)),
+  };
+}
+
+static void ArgusMeterInit(MTAudioProcessingTapRef tap, void *clientInfo, void **tapStorageOut)
+{
+  *tapStorageOut = NULL;
+}
+
+static void ArgusMeterFinalize(MTAudioProcessingTapRef tap) {}
+
+static void ArgusMeterPrepare(MTAudioProcessingTapRef tap, CMItemCount maxFrames, const AudioStreamBasicDescription *format)
+{
+  atomic_store(&sArgusTapIsFloat, (format->mFormatID == kAudioFormatLinearPCM && (format->mFormatFlags & kAudioFormatFlagIsFloat) && format->mBitsPerChannel == 32) ? 1 : 0);
+  atomic_store(&sArgusTapSampleRate, (int32_t)format->mSampleRate);
+}
+
+static void ArgusMeterUnprepare(MTAudioProcessingTapRef tap) {}
+
+static void ArgusMeterProcess(MTAudioProcessingTapRef tap, CMItemCount numberFrames, MTAudioProcessingTapFlags flags, AudioBufferList *bufferListInOut, CMItemCount *numberFramesOut, MTAudioProcessingTapFlags *flagsOut)
+{
+  // Pass-through: the audio is fetched into the caller's buffers and never
+  // modified. Everything below only reads it.
+  if (MTAudioProcessingTapGetSourceAudio(tap, numberFrames, bufferListInOut, flagsOut, NULL, numberFramesOut) != noErr) {
+    return;
+  }
+  CMItemCount frames = *numberFramesOut;
+  atomic_fetch_add(&sArgusRenderFrames, (uint64_t)frames);
+  if (atomic_load(&sArgusTapIsFloat) != 1 || bufferListInOut->mNumberBuffers == 0) {
+    return;
+  }
+  const AudioBuffer *buffer = &bufferListInOut->mBuffers[0];
+  const float *samples = (const float *)buffer->mData;
+  UInt32 count = buffer->mDataByteSize / sizeof(float);
+  if (!samples || count == 0) {
+    return;
+  }
+  float peak = 0;
+  double sumSquares = 0;
+  for (UInt32 i = 0; i < count; i++) {
+    float v = fabsf(samples[i]);
+    if (v > peak) peak = v;
+    sumSquares += (double)v * v;
+  }
+  // -60 dBFS: speech clears it easily, digital silence never does.
+  if (sqrt(sumSquares / count) > 0.001) {
+    atomic_fetch_add(&sArgusAudibleFrames, (uint64_t)frames);
+  }
+  uint32_t scaled = (uint32_t)(fminf(peak, 1.0f) * 10000);
+  uint32_t current = atomic_load(&sArgusRenderPeak);
+  while (scaled > current && !atomic_compare_exchange_weak(&sArgusRenderPeak, &current, scaled)) {}
+}
 
