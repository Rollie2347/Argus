+// One compact token per player for the #64 diagnostics line:
+// timeControlStatus/rate/volume/muted/itemStatus/waitReason/positionMs
+//   timeControlStatus 0 paused, 1 waiting, 2 playing
+//   itemStatus 0 unknown, 1 ready, 2 failed
+//   waitReason - none, s minimize stalls, e evaluating buffering, n no item, o other
+- (NSString *)argusPlayerSnapshot
+{
+  AVQueuePlayer *player = _player;
+  if (!player) {
+    return @"x";
+  }
+  NSString *why = @"-";
+  AVPlayerWaitingReason reason = player.reasonForWaitingToPlay;
+  if (reason) {
+    if ([reason isEqualToString:AVPlayerWaitingToMinimizeStallsReason]) why = @"s";
+    else if ([reason isEqualToString:AVPlayerWaitingWhileEvaluatingBufferingRateReason]) why = @"e";
+    else if ([reason isEqualToString:AVPlayerWaitingWithNoItemToPlayReason]) why = @"n";
+    else why = @"o";
+  }
+  AVPlayerItem *item = player.currentItem;
+  double positionMs = item ? CMTimeGetSeconds(item.currentTime) * 1000 : -1;
+  return [NSString stringWithFormat:@"%ld/%.2f/%.2f/%d/%ld/%@/%.0f",
+          (long)player.timeControlStatus, player.rate, player.volume, player.muted ? 1 : 0,
+          (long)(item ? item.status : -1), why, isnan(positionMs) ? -1 : positionMs];
+}
