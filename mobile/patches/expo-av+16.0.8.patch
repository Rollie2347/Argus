 - (void)handleAudioSessionInterruption:(NSNotification *)notification
 {
+  NSNumber *interruptionType = [[notification userInfo] objectForKey:AVAudioSessionInterruptionTypeKey];
+  // Argus: when an interruption begins (a call, Siri, an alarm, another app
+  // taking non-mixable audio) iOS DEACTIVATES the session. This manager never
+  // noticed: _sessionIsActive stayed YES, so every later pass saw "already
+  // active" and skipped setActive:YES for good. AVPlayer then kept "playing"
+  // into a session that was not rendering to hardware — the playhead
+  // advanced, didJustFinish fired, and nothing came out. That is the silent
+  // audio that survived reconnects, because this object outlives every
+  // session.
+  if (interruptionType.unsignedIntegerValue == AVAudioSessionInterruptionTypeBegan) {
+    _sessionIsActive = NO;
+  }
   for (id foregroundedModule in [_foregroundedModules allObjects]) {
     [foregroundedModule handleAudioSessionInterruption:notification];
   }
+  if (interruptionType.unsignedIntegerValue == AVAudioSessionInterruptionTypeEnded) {
+    [self _scheduleResync];
+  }
 }
 
 - (void)handleMediaServicesReset:(NSNotification *)notification
 {
+  // Argus: after mediaserverd resets, the real session is back at its
+  // defaults and inactive, but the cached category below still claimed it was
+  // configured — so setCategory was never called again and the app stayed
+  // unable to play until it was killed. Forget everything and rebuild.
+  _activeCategory = nil;
+  _activeOptions = 0;
+  _sessionIsActive = NO;
   for (id foregroundedModule in [_foregroundedModules allObjects]) {
     [foregroundedModule handleMediaServicesReset:notification];
   }
+  [self _scheduleResync];
+}
+
+- (void)handleRouteChange:(NSNotification *)notification
+{
+  [self _scheduleResync];
+}
+
+// Route-change notifications arrive on an arbitrary thread; EXAV's own calls
+// run on the main queue, so resyncing there keeps every session change on one
+// serial queue. Coalesced, because a single device change can post several.
+// Loops cannot form: every step in _updateSessionConfiguration is now a no-op
+// when the real session already matches, so the notification our own repair
+// posts leads to a pass that changes nothing and posts nothing.
+- (void)_scheduleResync
+{
+  @synchronized (self) {
+    if (_resyncScheduled) {
+      return;
+    }
+    _resyncScheduled = YES;
+  }
+  dispatch_async(dispatch_get_main_queue(), ^{
+    @synchronized (self) {
+      self.resyncScheduled = NO;
+    }
+    // Never reconfigure while backgrounded — with no foregrounded module the
+    // requested category falls back to Ambient, which is not a repair.
+    if ([[self.foregroundedModules allObjects] count] == 0) {
+      return;
+    }
+    [self _updateSessionConfiguration];
+  });
+}
+
+// Argus: whether the REAL AVAudioSession no longer matches what this manager
+// last configured. Both caches in this file (the per-module settings in
+// setCategory:forModule: and _activeCategory/_activeOptions in
+// _updateSessionConfiguration) compared requests against earlier requests and
+// never against the session itself — so once anything outside expo-av changed
+// the session, it was never put back.
+- (BOOL)_realSessionHasDrifted
+{
+  if (!_activeCategory) {
+    return NO;
+  }
+  AVAudioSession *session = [AVAudioSession sharedInstance];
+  if (![session.category isEqualToString:_activeCategory]) {
+    return YES;
+  }
+  if (_optionsVerifiable && (session.categoryOptions & _activeOptions) != _activeOptions) {
+    return YES;
+  }
+  if ([_activeCategory isEqualToString:AVAudioSessionCategoryPlayAndRecord]) {
+    if (![session.mode isEqualToString:AVAudioSessionModeVoiceChat]) {
+      return YES;
+    }
+    if ([self _outputIsOnReceiver:session]) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+- (BOOL)_outputIsOnReceiver:(AVAudioSession *)session
+{
+  for (AVAudioSessionPortDescription *output in session.currentRoute.outputs) {
+    if ([output.portType isEqualToString:AVAudioSessionPortBuiltInReceiver]) {
+      return YES;
+    }
+  }
+  return NO;
 }
 
