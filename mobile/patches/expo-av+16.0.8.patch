diff --git a/node_modules/expo-av/ios/EXAV/EXAV.m b/node_modules/expo-av/ios/EXAV/EXAV.m
index 7153d28..5e7da86 100644
--- a/node_modules/expo-av/ios/EXAV/EXAV.m
+++ b/node_modules/expo-av/ios/EXAV/EXAV.m
@@ -326,6 +326,13 @@ EX_EXPORT_MODULE(ExponentAV);
   if (_allowsAudioRecording) {
     // Bluetooth input is only available when recording is allowed
     requiredAudioCategoryOptions = requiredAudioCategoryOptions | AVAudioSessionCategoryOptionAllowBluetooth;
+    // Without this, .playAndRecord defaults output to the earpiece receiver
+    // instead of the main speaker when no external accessory is connected —
+    // besides being quiet, receiver-routed playback isn't treated as a normal
+    // media route, so hardware volume buttons don't audibly affect it.
+    // DefaultToSpeaker only changes the default when no Bluetooth/wired
+    // accessory is active; those still take priority automatically.
+    requiredAudioCategoryOptions = requiredAudioCategoryOptions | AVAudioSessionCategoryOptionDefaultToSpeaker;
   }

   return [_kernelAudioSessionManagerDelegate setCategory:requiredAudioCategory withOptions:requiredAudioCategoryOptions forModule:self];
diff --git a/node_modules/expo-av/ios/EXAV/EXAudioSessionManager.m b/node_modules/expo-av/ios/EXAV/EXAudioSessionManager.m
index 3e768d1..ba86ece 100644
--- a/node_modules/expo-av/ios/EXAV/EXAudioSessionManager.m
+++ b/node_modules/expo-av/ios/EXAV/EXAudioSessionManager.m
@@ -247,10 +247,22 @@ EX_REGISTER_SINGLETON_MODULE(AudioSessionManager);
     return error;
   }

   if (shouldBeActive && !_sessionIsActive) {
     [session setActive:YES error:&error];
     if (!error) {
       _sessionIsActive = YES;
     }
   }
+
+  // Re-assert the speaker route on EVERY configuration pass, not just on the
+  // inactive->active transition. The session stays active across recording
+  // cycles, so once _sessionIsActive is YES that branch never runs again —
+  // but each setCategory: resets the output route back to the .playAndRecord
+  // default (the earpiece receiver), which is quiet AND sounds muffled. That
+  // is why raising AUDIO_GAIN 1.6 -> 3.2 -> 5.0 never fixed the complaint:
+  // wrong transducer, not wrong level. Not fatal if it fails.
+  if (_sessionIsActive && [category isEqualToString:AVAudioSessionCategoryPlayAndRecord]) {
+    NSError *overrideError;
+    [session overrideOutputAudioPort:AVAudioSessionPortOverrideSpeaker error:&overrideError];
+  }

