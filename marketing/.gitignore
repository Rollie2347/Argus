# Generated by scripts/make-slideshow.mjs — 142 PNGs for the current batch.
# Reproducible from decks/ + templates/ in ~22s, so it doesn't belong in git.
out/

# AI-generated slide photos (scripts/make-images.mjs). Paid for, but cached by
# prompt hash and regenerable; on a server they live on the /data volume.
assets/generated/

# Decks written by the daily writer (scripts/write-decks.mjs), named
# <yymmdd>-<n>-<slug>. The operational record of them is the approval queue;
# locally they are scratch. Hand-written decks (01-…, 02-…) stay tracked.
decks/[0-9][0-9][0-9][0-9][0-9][0-9]-*.json

# This folder is also published on its own (github.com/Rollie2347/ArgusMarketingBot),
# where the Argus repo's root .gitignore doesn't apply — so the basics are
# repeated here.
node_modules/
.env
.env.txt
*.log
bot/state/
