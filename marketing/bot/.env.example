# ============================================================
# Argus marketing pipeline — secrets and settings
# ============================================================
# Copy to bot/.env (gitignored). Never commit this filled in, and never echo
# these values in a terminal — bot startup prints lengths only, on purpose.
# On a server, put these in the platform's env store instead of a file.

# REQUIRED — from @BotFather. Shape: "<botid>:<secret>".
# ⚠️ Telegram puts this in every request URL, so treat any log line containing
# an api.telegram.org URL as a leaked credential.
TELEGRAM_BOT_TOKEN=

# REQUIRED — the ONLY Telegram user id allowed to operate this bot.
# Get it by messaging @userinfobot. An unlocked bot means anyone who finds its
# username can approve posts to the real accounts.
TELEGRAM_CHAT_ID=

# Seconds Telegram holds an empty long-poll open. 30 is fine.
# TELEGRAM_POLL_TIMEOUT_SEC=30

# ============================================================
# Daily batch — deck writing + image generation (Gemini)
# ============================================================
# A key from a SEPARATE GCP project, not the Argus backend's GEMINI_API_KEY:
# a runaway loop or billing hold here must never take the live app down with
# it. Give that project a budget alert. See lib/gemini.mjs.
MARKETING_GEMINI_API_KEY=

# Models (defaults shown; current as of 2026-09).
# MARKETING_TEXT_MODEL=gemini-3.8-flash
# MARKETING_IMAGE_MODEL=gemini-3.1-flash-image

# When the bot writes the day's decks, local time (HH:MM). Unset = only on /generate.
# DAILY_RUN_AT=07:00
# Decks per batch.
# DECKS_PER_DAY=3
# Days before a hook id may be reused.
# HOOK_REPEAT_DAYS=7
# Hard cap on image generations per run (cost guard).
# MAX_IMAGES_PER_RUN=12

# ============================================================
# Posting schedule
# ============================================================
# Approved posts go out at these local times. Unset = post the moment you approve.
# POST_TIMES=09:00,13:00,19:00
# Per platform per day. Keep 1 for the ~10-day account warm-up
# (CALENDAR.md, RESEARCH §6.1), then raise to 3.
# POSTS_PER_DAY=1
# On a server, set the timezone the times above mean:
# TZ=America/Chicago

# ============================================================
# Publishing — the FREE setup (2026-09-26)
# ============================================================
#   tiktokweb  TikTok only, free and automatic: a browser bot posts on TikTok's
#              website as a slideshow VIDEO (the site can't make photo
#              carousels). Against TikTok's terms — accepted 2026-09-26. Needs
#              `npm install` and a one-time `npm run tiktok-login`; rehearse
#              with `node scripts/tiktok-dry-run.mjs`.
#   telegram   (default) at the slot, the slides + steps + a tap-to-copy caption
#              arrive in Telegram; you post from the phone, tap "I posted it"
#   instagram  free and automatic: Instagram API with Instagram Login. Needs
#              IG_USER_ID + IG_ACCESS_TOKEN below, and the slide bucket.
#   instagramweb  Instagram without a Professional account: a browser bot
#              posts the carousel on instagram.com. Against Instagram's terms.
#              One-time `npm run instagram-login`; rehearse with
#              `node scripts/instagram-dry-run.mjs`.
#   uploadpost paid (~$16-24/mo), automatic on BOTH platforms incl. TikTok
#   manual     legacy: a hand-off file on the bot machine's own disk
# PUBLISH_TIKTOK=telegram
# PUBLISH_INSTAGRAM=instagram      # once IG_USER_ID and IG_ACCESS_TOKEN are set

# ---- Instagram (Instagram API with Instagram Login — no Facebook Page) ----
# Meta app dashboard → Instagram → API setup with Instagram login → add the
# account as an Instagram tester → Generate token. Both values are shown there.
# The bot refreshes the token itself every 7 days (state/ig-token.json); paste
# a new one here only if it ever expires.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# IG_GRAPH_VERSION=v25.0

# ---- Slide hosting for Instagram (it fetches images by URL, JPEG only) ----
# Public-read bucket in n8n-ai-agents-470515; objects auto-delete after 14
# days. The key belongs to a service account that can ONLY add objects to
# that one bucket. Base64 of the key JSON. See lib/gcs.mjs.
# MARKETING_GCS_BUCKET=argus-marketing-slides-470515
# MARKETING_GCS_KEY_B64=

# Set to 1 to make the API publishers report what they WOULD send and stop.
# DRY_RUN=1

# ---- paid alternative: Upload-Post ----
# UPLOADPOST_API_KEY=
# UPLOADPOST_USER=
# DIRECT_POST publishes; MEDIA_UPLOAD sends TikTok a draft (use for a first run).
# UPLOADPOST_TIKTOK_POST_MODE=DIRECT_POST
# UPLOADPOST_TIKTOK_AUTO_MUSIC=1
