# ============================================================
# Argus marketing approval bot — secrets
# ============================================================
# Copy to bot/.env (gitignored). Never commit this filled in, and never echo
# these values in a terminal — bot startup prints lengths only, on purpose.

# REQUIRED — from @BotFather. Shape: "<botid>:<secret>".
# ⚠️ Telegram puts this in every request URL, so treat any log line containing
# an api.telegram.org URL as a leaked credential.
TELEGRAM_BOT_TOKEN=

# REQUIRED — the ONLY Telegram user id allowed to operate this bot.
# Get it by messaging @userinfobot. An unlocked bot means anyone who finds its
# username can approve posts to the real accounts.
TELEGRAM_CHAT_ID=

# Seconds Telegram holds an empty long-poll open. 30 is fine.
# TELEGRAM_POLL_TIMEOUT_SEC=30

# ============================================================
# Publishing — both default to "manual" (approved asset, post by hand)
# ============================================================
# "manual" or "tiktok". tiktok ALWAYS fails today: Direct Post needs a passed
# app audit, and without it every post is forced SELF_ONLY. See
# bot/publishers/tiktok.mjs.
# PUBLISH_TIKTOK=manual

# "manual" or "instagram". The instagram adapter is written but UNVERIFIED —
# it has never run against the real API. Do the first run with DRY_RUN=1.
# PUBLISH_INSTAGRAM=manual

# Only needed when PUBLISH_INSTAGRAM=instagram.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# Meta FETCHES image URLs server-side — the PNGs must already be on a public
# HTTPS host. Slides resolve as <base>/<deckId>/<platform>/<NN>.png
# IG_PUBLIC_ASSET_BASE=
# IG_GRAPH_VERSION=v21.0

# Set to 1 to make the instagram adapter report what it WOULD send and stop.
# DRY_RUN=1
